# ─── MySQL Database Configuration ─────────────────────────────────
# Connection string cho PollService (quản lý polls và options)
POLL_DB_CONNECTION=Server=YOUR_MYSQL_HOST;Port=3306;Database=YOUR_POLLDB_NAME;User=YOUR_USER;Password=YOUR_PASSWORD;AllowPublicKeyRetrieval=true;

# Connection string cho VoteService (quản lý votes)
VOTE_DB_CONNECTION=Server=YOUR_MYSQL_HOST;Port=3306;Database=YOUR_VOTEDB_NAME;User=YOUR_USER;Password=YOUR_PASSWORD;AllowPublicKeyRetrieval=true;

# ─── Service URLs (for Docker/Production) ─────────────────────────
# URL công khai của Gateway (browser gọi đến)
# Local Docker: http://localhost:5000
# Render: https://ocelot-gateway.onrender.com
GATEWAY_PUBLIC_URL=http://localhost:5000

# URL công khai của VoteService cho SignalR
# Local Docker: http://localhost:5002
# Render: https://vote-service.onrender.com
VOTE_SERVICE_PUBLIC_URL=http://localhost:5002

# URL của Frontend (dùng cho CORS AllowedOrigins)
# Local Docker: http://localhost:8081
# Render: https://poll-client.onrender.com
FRONTEND_URL=http://localhost:8081
